{
  "name": "kicker-server",
  "version": "1.0.0",
  "description": "kicker API + real-time game server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/scripts/ingest-wikidata-players.ts --format esm --clean",
    "start": "node dist/index.js",
    "dump:wikidata": "tsx src/scripts/ingest-wikidata-players.ts --dump",
    "seed:wikidata": "tsx src/scripts/ingest-wikidata-players.ts --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "pg": "^8.20.0",
    "socket.io": "^4.8.1",
    "tsup": "^8.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.6.2",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.5.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
